DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kootahak-db?schema=public"
JWT_SECRET="change-me" # must be 32+ chars, not this placeholder
FRONT_END_URL="http://localhost:3000"
# Hostname the public redirect route (GET /:shortCode) is restricted to.
# Production: the purchased short-link domain, e.g. "c7j.ir".
# Local dev: a hostname mapped to 127.0.0.1 in the OS hosts file, e.g. "c7j.local".
REDIRECT_HOST="c7j.local"
PORT="8000"
NODE_ENV="development"
REDIS_HOST="localhost"
REDIS_PORT="6379"
GEOLOCATION_TOKEN="get token freom here ===> ipgeolocation.io"
# Non-production only: the local visitor IP is a bogon (127.0.0.1) which the
# geo-IP API rejects, so this routable IP is looked up instead. Ignored when
# NODE_ENV=production (the real visitor IP is always used there).
GEO_FALLBACK_IP="8.8.8.8"
